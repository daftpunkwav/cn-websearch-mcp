# Copy to .env and fill in the keys you have. Never commit .env.
# Slots without a key (or with <NAME>_ENABLED=false) are skipped.

# Slot: kimi  — chat-completions with a multi-round tool-call loop and a separate fiber endpoint
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn
KIMI_MODEL=kimi-k3

# Slot: mimo  — chat-completions with a server-side web_search tool
MIMO_API_KEY=
MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5

# Slot: zhipu — standalone web-search API (POST {base}/api/paas/v4/web_search)
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn
# Optional: search_std | search_pro | search_pro_sogou | search_pro_quark
# ZHIPU_SEARCH_ENGINE=search_std

# Slot: stepfun — standalone search REST endpoint (POST {base}/v1/search)
STEPFUN_API_KEY=
STEPFUN_BASE_URL=https://api.stepfun.com

# ---- Optional per-slot overrides (any slot name works the same way)
# <NAME>_MODEL / <NAME>_BASE_URL / <NAME>_ENABLED / <NAME>_PRIORITY / <NAME>_TIMEOUT_MS
# KIMI_PRIORITY=5
# MIMO_ENABLED=false
# STEPFUN_TIMEOUT_MS=45000

# ---- Optional gateway settings
# Slot order. Omit it to use the alphabetical default (no built-in preference).
# WEBSEARCH_ORDER=stepfun,zhipu,kimi
# Default search strategy: fallback | aggregate
# WEBSEARCH_STRATEGY=aggregate
# Per-attempt timeout budget in ms (a transient retry gets a fresh budget).
# WEBSEARCH_TIMEOUT_MS=30000
# Default result count when a tool call omits `count`.
# WEBSEARCH_COUNT=8
# Maximum number of slots used per call.
# WEBSEARCH_MAX_PROVIDERS=4
# Merge duplicate URLs when aggregating (true | false).
# WEBSEARCH_DEDUPE=true
# Path to a JSON config file (default: ./cn-websearch.config.json if present).
# WEBSEARCH_CONFIG=./cn-websearch.config.json
