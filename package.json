{
  "name": "cn-websearch-mcp",
  "version": "0.2.0",
  "description": "MCP server and CLI that fronts multiple built-in web-search channels (OpenAI-compatible chat-completions with a multi-round tool loop or a server-side web_search tool, plus standalone search REST endpoints) behind a single tool, with configurable slot priority, fallback, multi-source aggregation, per-attempt timeout, and one transient retry.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "cn-websearch-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.check.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "smoke": "tsx scripts/smoke.ts",
    "cli": "tsx src/index.ts",
    "prepack": "npm run build"
  },
  "keywords": [
    "mcp",
    "modelcontextprotocol",
    "web-search",
    "multi-source",
    "fallback",
    "aggregate",
    "cli",
    "tool-use"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "eslint-config-airbnb-extended": "^3.3.0",
    "globals": "^17.13.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "vite": "^6.4.4"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  }
}
